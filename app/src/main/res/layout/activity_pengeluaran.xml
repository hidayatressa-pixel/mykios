<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
<com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" app:elevation="0dp"><com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="68dp" app:title="Pengeluaran" app:subtitle="Catat biaya operasional kios" app:titleTextColor="@color/text_primary" app:subtitleTextColor="@color/text_secondary" app:navigationIcon="@drawable/ic_nav_back" app:navigationIconTint="@color/text_primary"/></com.google.android.material.appbar.AppBarLayout>
