<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingHorizontal="8dp"
            app:title="Stok Barang"
            app:subtitle="Kelola inventori dengan cepat"
            app:titleTextColor="@color/text_primary"
            app:subtitleTextColor="@color/text_secondary"
            app:navigationIcon="@drawable/ic_nav_back"
            app:navigationIconTint="@color/text_primary"
            app:menu="@menu/menu_stok" />

        <RelativeLayout
            android:id="@+id/layoutSelection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/primary"
            android:paddingHorizontal="18dp"
            android:visibility="gone">
            <ImageView android:id="@+id/btnCloseSelection" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:padding="8dp" android:src="@drawable/ic_nav_close" app:tint="@color/white"/>
            <TextView android:id="@+id/tvSelectionCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="10dp" android:layout_toEndOf="@id/btnCloseSelection" android:text="0 Terpilih" android:textColor="@color/white" android:textStyle="bold"/>
            <ImageView android:id="@+id/btnDeleteSelected" android:layout_width="36dp" android:layout_height="36dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:padding="8dp" android:src="@drawable/ic_nav_delete" app:tint="@color/white"/>
        </RelativeLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Semua"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStok"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="112dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <LinearLayout
        android:id="@+id/layoutEmptyStok"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <ImageView android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/bg_icon_soft" android:padding="18dp" android:src="@drawable/ic_nav_stock" app:tint="@color/primary"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Belum ada barang" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Tambahkan barang pertama untuk mulai mengelola stok." android:textColor="@color/text_secondary" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabScanner"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Scan barang"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@color/primaryContainer"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_nav_scan"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/primary"
            app:iconSize="22dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabImport"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Download atau import stok"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@color/primaryContainer"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_nav_import"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/primary"
            app:iconSize="22dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabToolbox"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Barcode dan pengaturan stok"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@color/primaryContainer"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_nav_tools"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/primary"
            app:iconSize="22dp"
            app:strokeWidth="0dp" />

        <View
            android:id="@+id/fabMenuToggle"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabTambahBarang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Tambah barang"
        android:text="Tambah"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_nav_add"
        app:iconTint="@color/white"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>