<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
<com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" app:elevation="0dp"><com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="68dp" app:title="Asset Pengguna" app:subtitle="Identitas pembayaran kios" app:titleTextColor="@color/text_primary" app:subtitleTextColor="@color/text_secondary" app:navigationIcon="@drawable/ic_nav_back" app:navigationIconTint="@color/text_primary"/></com.google.android.material.appbar.AppBarLayout>
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" app:layout_behavior="@string/appbar_scrolling_view_behavior"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/primaryContainer" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_soft" android:padding="10dp" android:src="@drawable/ic_nav_image" app:tint="@color/primary"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QRIS Toko" android:textColor="@color/onPrimaryContainer" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Gunakan gambar QRIS resmi milik usaha Anda." android:textColor="@color/text_secondary" android:textSize="11sp"/></LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/outline_soft" app:strokeWidth="1dp"><FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp"><ImageView android:id="@+id/ivAssetQris" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="QRIS toko" android:scaleType="fitCenter" android:src="@drawable/ic_nav_qr"/><TextView android:id="@+id/tvNoQris" android:layout_width="match_parent" android:layout_height="match_parent" android:drawableTop="@drawable/ic_nav_qr" android:gravity="center" android:text="Belum ada QRIS\nUpload gambar QRIS untuk pembayaran" android:textAlignment="center" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:visibility="gone"/></FrameLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/btnUploadQris" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Upload / Ganti QRIS" android:textAllCaps="false" app:cornerRadius="16dp" app:icon="@drawable/ic_nav_image"/><include layout="@layout/footer_brand"/>
</LinearLayout></androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>