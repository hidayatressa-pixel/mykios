<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/gradient_success">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnim"
            android:layout_width="180dp"
            android:layout_height="180dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/pos_machine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🎉 SELAMAT! 🎉"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6200EE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Anda Kini Member PRO"
            android:textSize="18sp"
            android:textColor="#444" />

        <View
            android:layout_width="80dp"
            android:layout_height="4dp"
            android:layout_marginVertical="20dp"
            android:background="#6200EE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 Laporan Eksklusif"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"
                android:textColor="#555" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 Fitur AI Engine"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"
                android:textColor="#555" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎 Bebas Iklan Selamanya"
                android:textSize="15sp"
                android:textColor="#555" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplore"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="MULAI JELAJAHI"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            android:backgroundTint="#6200EE"
            android:textColor="@android:color/white" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
